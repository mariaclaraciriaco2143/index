/* =========================================
   RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    background: #05070a;
    color: #e8edf2;

    font-family: "Segoe UI", Arial, sans-serif;

    line-height: 1.6;
}



/* =========================================
   FUNDO
========================================= */

body::before {
    content: "";

    position: fixed;

    width: 500px;
    height: 500px;

    top: -250px;
    right: -200px;

    background: rgba(18, 72, 85, 0.08);

    border-radius: 50%;

    filter: blur(100px);

    pointer-events: none;

    z-index: -1;
}



/* =========================================
   HERO
========================================= */

.hero {
    width: 1100px;
    max-width: 90%;

    min-height: 90vh;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 100px;
}



/* =========================================
   TEXTO DO HERO
========================================= */

.hero-text {
    max-width: 610px;
}


.hero-tag {
    color: #4d8792;

    font-size: 12px;

    font-weight: 600;

    letter-spacing: 3px;

    display: inline-block;

    margin-bottom: 25px;
}


.hero h1 {
    font-size: 68px;

    line-height: 1.05;

    letter-spacing: -2px;

    font-weight: 700;

    margin-bottom: 18px;
}


.hero h1 span {
    display: block;

    color: #477b85;
}


.hero h2 {
    color: #aab4bd;

    font-size: 22px;

    font-weight: 400;

    margin-bottom: 25px;
}


.hero p {
    color: #737e89;

    font-size: 16px;

    line-height: 1.8;

    max-width: 560px;

    margin-bottom: 35px;
}



/* =========================================
   BOTÕES
========================================= */

.hero-buttons {
    display: flex;

    gap: 12px;

    margin: 0;
}


.hero-buttons a {
    text-decoration: none;

    padding: 13px 22px;

    border-radius: 5px;

    font-size: 14px;

    font-weight: 600;

    display: flex;

    align-items: center;

    gap: 14px;

    transition: all 0.25s ease;
}


.btn-primary {
    background: #315c64;

    color: #ffffff;

    border: 1px solid #315c64;
}


.btn-primary:hover {
    background: #3b707a;

    transform: translateY(-2px);
}


.btn-primary span {
    transition: transform 0.25s ease;
}


.btn-primary:hover span {
    transform: translateX(4px);
}


.btn-secondary {
    background: transparent;

    color: #aeb8c2;

    border: 1px solid #293039;
}


.btn-secondary:hover {
    border-color: #486d75;

    color: #ffffff;

    background: #0a0e12;

    transform: translateY(-2px);
}



/* =========================================
   FOTO
========================================= */

.hero-photo {
    position: relative;

    width: 390px;
    height: 390px;

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;
}


.photo-background {
    position: absolute;

    width: 350px;
    height: 350px;

    border-radius: 50%;

    background: #0b1116;

    border: 1px solid #202a31;
}


.photo-frame {
    position: relative;

    width: 315px;
    height: 315px;

    border-radius: 50%;

    overflow: hidden;

    border: 1px solid #426872;

    background: #0b0f13;

    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.5);
}


.photo-frame img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;
}


.tech-line {
    position: absolute;

    width: 390px;
    height: 390px;

    border-radius: 50%;

    border: 1px solid transparent;

    border-top-color: #315c64;

    transform: rotate(35deg);

    opacity: 0.7;
}



/* =========================================
   SEÇÕES
========================================= */

.content-section {
    width: 1000px;

    max-width: 85%;

    margin: auto;

    padding: 100px 0;

    border-top: 1px solid #141a20;
}


.section-tag {
    display: block;

    color: #4d8792;

    font-size: 11px;

    font-weight: 600;

    letter-spacing: 3px;

    margin-bottom: 12px;
}


.content-section h2 {
    color: #dfe5ea;

    font-size: 32px;

    font-weight: 600;

    margin-bottom: 25px;
}


.content-section h2::before {
    content: "// ";

    color: #416b74;
}


.content-section > p {
    color: #77828d;

    max-width: 800px;

    font-size: 16px;
}



/* =========================================
   HABILIDADES
========================================= */

.skill-list {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 15px 50px;

    margin-top: 35px;
}


.skill-item {
    padding: 18px 0;

    border-bottom: 1px solid #171e24;
}


.skill-item h3 {
    color: #cbd3d9;

    font-size: 17px;

    font-weight: 600;

    margin-bottom: 5px;
}


.skill-item p {
    color: #68747e;

    font-size: 14px;
}



/* =========================================
   HABILIDADES TÉCNICAS
========================================= */

.technical-group {
    margin-top: 35px;

    padding-bottom: 25px;

    border-bottom: 1px solid #171e24;
}


.technical-group h3 {
    color: #cbd3d9;

    font-size: 18px;

    margin-bottom: 15px;
}


.technical-group p {
    color: #77828d;

    font-size: 15px;

    margin-bottom: 8px;
}



/* =========================================
   LISTAS SIMPLES
========================================= */

.simple-list {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 12px 60px;

    margin-top: 30px;
}


.simple-list p {
    padding: 14px 0;

    border-bottom: 1px solid #171e24;

    color: #8a959f;

    font-size: 15px;
}



/* =========================================
   CONTATO
========================================= */

.contact {
    text-align: center;
}


.contact > p {
    margin: 0 auto 35px;
}


.contact-links {
    display: flex;

    justify-content: center;

    gap: 20px;

    flex-wrap: wrap;

    margin-top: 35px;
}


.contact-links a {
    width: 180px;

    min-height: 65px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 12px;

    background: #0a1015;

    border: 1px solid #1d2a32;

    border-radius: 10px;

    color: #aeb8c2;

    text-decoration: none;

    transition: all 0.3s ease;
}


.contact-links a:hover {
    transform: translateY(-5px);

    background: #0d171d;

    border-color: #426872;

    color: #ffffff;

    box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.35);
}


.contact-links img {
    width: 30px;
    height: 30px;

    object-fit: contain;

    transition: transform 0.3s ease;
}


.contact-links a:hover img {
    transform: scale(1.12);
}


.contact-links a span:last-child {
    font-size: 14px;

    font-weight: 600;
}



/* =========================================
   LINKEDIN
========================================= */

.linkedin-icon {
    width: 30px;
    height: 30px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #315c64;

    color: #ffffff;

    border-radius: 5px;

    font-size: 15px;

    font-weight: bold;
}



/* =========================================
   RODAPÉ
========================================= */

footer {
    padding: 35px 20px;

    text-align: center;

    border-top: 1px solid #141a20;

    color: #4f5962;

    font-size: 13px;
}


footer p {
    margin: 4px auto;
}



/* =========================================
   PÁGINA DE PROJETOS
========================================= */

.projetos-page {
    width: 1000px;

    max-width: 85%;

    min-height: 100vh;

    margin: auto;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;
}


.projetos-page .hero-tag {
    margin-bottom: 15px;
}


.projetos-page h1 {
    font-size: 60px;

    line-height: 1.1;

    margin: 15px 0 25px;

    color: #e8edf2;
}


.projetos-page h1 span {
    display: block;

    color: #477b85;
}


.projetos-page > p {
    max-width: 650px;

    color: #737e89;

    font-size: 16px;

    line-height: 1.8;

    margin-bottom: 40px;
}


.projeto-status {
    width: 100%;

    max-width: 650px;

    padding: 35px;

    background: #080d12;

    border: 1px solid #182129;

    border-radius: 10px;

    margin-bottom: 35px;

    transition: 0.3s ease;
}


.projeto-status:hover {
    border-color: #315c64;

    transform: translateY(-3px);

    box-shadow:
        0 15px 40px rgba(0, 0, 0, 0.3);
}


.status-icon {
    width: 50px;
    height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #0d171d;

    border: 1px solid #315c64;

    border-radius: 8px;

    color: #5d9aa5;

    font-size: 18px;

    font-weight: bold;

    margin-bottom: 20px;
}


.projeto-status h2 {
    color: #dfe5ea;

    font-size: 22px;

    margin-bottom: 8px;
}


.projeto-status h2::before {
    content: "";
}


.projeto-status p {
    color: #68747e;

    font-size: 14px;
}


.projetos-page .btn-primary {
    text-decoration: none;

    padding: 13px 22px;

    border-radius: 5px;

    background: #315c64;

    color: #ffffff;

    border: 1px solid #315c64;

    font-size: 14px;

    font-weight: 600;

    transition: 0.25s ease;
}


.projetos-page .btn-primary:hover {
    background: #3b707a;

    transform: translateY(-2px);
}



/* =========================================
   RESPONSIVO
========================================= */

@media (max-width: 1000px) {

    .hero {
        gap: 50px;
    }

}


@media (max-width: 900px) {

    .hero {
        flex-direction: column-reverse;

        justify-content: center;

        text-align: center;

        padding: 80px 0;

        gap: 60px;
    }


    .hero-text {
        max-width: 650px;
    }


    .hero h1 {
        font-size: 52px;
    }


    .hero h2 {
        font-size: 20px;
    }


    .hero p {
        margin-left: auto;

        margin-right: auto;
    }


    .hero-buttons {
        justify-content: center;
    }


    .hero-photo {
        width: 310px;

        height: 310px;
    }


    .photo-background {
        width: 280px;

        height: 280px;
    }


    .photo-frame {
        width: 250px;

        height: 250px;
    }


    .tech-line {
        width: 310px;

        height: 310px;
    }


    .content-section {
        max-width: 85%;
    }

}


@media (max-width: 700px) {

    .skill-list,
    .simple-list {
        grid-template-columns: 1fr;
    }


    .content-section {
        padding: 70px 0;
    }


    .contact-links {
        flex-direction: column;

        align-items: center;
    }


    .contact-links a {
        width: 220px;
    }


    .projetos-page {
        padding: 70px 0;
    }


    .projetos-page h1 {
        font-size: 48px;
    }

}


@media (max-width: 500px) {

    .hero {
        max-width: 92%;
    }


    .hero h1 {
        font-size: 42px;
    }


    .hero-buttons {
        flex-direction: column;

        align-items: center;
    }


    .hero-buttons a {
        width: 190px;

        justify-content: center;
    }


    .hero-photo {
        width: 280px;

        height: 280px;
    }


    .photo-background {
        width: 250px;

        height: 250px;
    }


    .photo-frame {
        width: 220px;

        height: 220px;
    }


    .tech-line {
        width: 280px;

        height: 280px;
    }


    .content-section {
        max-width: 90%;
    }


    .content-section h2 {
        font-size: 28px;
    }


    .projetos-page {
        max-width: 90%;
    }


    .projetos-page h1 {
        font-size: 40px;
    }

}
